# Supabase (used by @nuxtjs/supabase)
NUXT_PUBLIC_SUPABASE_URL=
NUXT_PUBLIC_SUPABASE_KEY=

# Optional: public origin used for link previews (og:url / og:image). Leave empty to
# take it from the request; set it when a proxy rewrites the host header.
NUXT_PUBLIC_SITE_URL=

# Server-only
SUPABASE_SERVICE_KEY=